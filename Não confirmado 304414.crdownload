from nethub.application.facade_controller import FacadeSingletonController as F


class Fake:
    def __init__(self, n=0):
        self.n = n

    def listar(self):
        return list(range(self.n))


def deps(inv=0, usr=0, ann=0):
    return [Fake(inv), object(), object(), object(), object(), object(), Fake(usr), Fake(ann)]


def test_mesma_composicao_retorna_mesma_instancia():
    d = deps()
    assert F(*d) is F(*d)


def test_composicoes_distintas_geram_instancias_distintas():
    assert F(*deps()) is not F(*deps())


def test_init_nao_sobrescreve_dependencias():
    d = deps(inv=2)
    a = F(*d)
    F(*d)
    assert a.inventario is d[0]


def test_expoe_todos_os_gerentes():
    d = deps()
    f = F(*d)
    for nome, dep in zip("inventario descoberta menu executor evidencias historico usuarios anotacoes".split(), d):
        assert getattr(f, nome) is dep


def test_contagem_soma_hosts_usuarios_anotacoes():
    assert F(*deps(inv=3, usr=2, ann=4)).quantidade_entidades_cadastradas() == 9


def test_contagem_zero():
    assert F(*deps()).quantidade_entidades_cadastradas() == 0


def test_contagem_reflete_mudancas():
    d = deps(inv=1)
    f = F(*d)
    d[0].n = 5
    assert f.quantidade_entidades_cadastradas() == 5
